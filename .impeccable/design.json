      "css": ".ds-label{font-family:system-ui,sans-serif;font-size:14px;display:block;color:#192D25;font-weight:700;margin-bottom:8px}.ds-description{font-family:system-ui,sans-serif;font-size:14px;background:#FEFFFC;color:#192D25;border:1px solid #D4DDD2;border-radius:8px;height:100px;padding:12px}.ds-description:hover{border-color:#77877C}.ds-description:focus-visible{outline:2px solid #AB302F;outline-offset:-2px}"
    },
    {
      "name": "Status badge",
      "kind": "chip",
      "refersTo": "badge-status",
      "description": "Noninteractive status label; no invented hover action. Illustrative light-theme HTML translation; Android remains authoritative.",
