  "narrative": {
    "northStar": "Calm Readiness",
    "overview": "A quiet, native information surface for decisions under pressure. Forest-green actions, warm pale neutrals and compact sans-serif typography give urgent content room to be read. Red carries incident reporting and emergency meaning; ordinary navigation stays calm.\n\nThe user chose premium restraint and fluidity, with Eon informing shared component architecture. The implementation remains Kotlin and Compose: native feedback, saved state and lightweight surfaces support that direction. This document records source behavior, not a claim of measured smoothness, outdoor readability, device acceptance or accessibility certification.",
    "keyCharacteristics": [
      "Semantic color in both light and dark themes.",
      "Readable headings and content-sized shared headers.",
      "Flat, softly rounded native surfaces.",
      "Explicit local, pending, error and permission states."
    ],
    "rules": [
      {
        "name": "The Meaning Before Accent Rule",
        "body": "Reserve emergency and warning tones for their semantic context; keep normal actions in primary green.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Shared cards and bottom navigation use tonal separation and borders rather than decorative shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use MaterialTheme semantic roles and shared QuakeCard and ScreenHeader components.",
      "Do retain Turkish action labels, source details and explicit local-versus-server status.",
      "Do keep headings content-sized and preserve native text scaling and interaction feedback.",
      "Do verify dark theme, large text and physical-device performance before declaring acceptance."
    ],
    "donts": [
      "Don't imply a local tracking code confirms server receipt or responder dispatch.",
      "Don't use emergency red as the default color of ordinary navigation.",
      "Don't introduce decorative looping motion or speculative performance guarantees.",
      "Don't treat the HTML previews as Android screenshots or native behavior tests."
    ]
  }
}
