  "components": [
    {
      "name": "Urgent report button",
      "kind": "button",
      "refersTo": "button-urgent",
      "description": "Report submission with explicit urgent meaning. Illustrative light-theme HTML translation; Android remains authoritative.",
      "html": "<button class=\"ds-control ds-urgent\">İhbarı Kaydet ve Gönderime Al</button>",
      "css": ".ds-urgent{font-family:system-ui,sans-serif;font-size:14px;background:#AB302F;color:#FFF;border:0;border-radius:8px;min-height:52px;padding:12px 20px;font-weight:700}.ds-control:hover{filter:brightness(.97)}.ds-control:focus-visible{outline:2px solid #176758;outline-offset:3px}.ds-control:active{filter:brightness(.92)}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Secondary native-style text action. Illustrative light-theme HTML translation; Android remains authoritative.",
      "html": "<button class=\"ds-control ds-text\">Haritada gör</button>",
      "css": ".ds-text{font-family:system-ui,sans-serif;font-size:14px;background:transparent;color:#176758;border:0;padding:12px;font-weight:600}.ds-control:hover{filter:brightness(.97)}.ds-control:focus-visible{outline:2px solid #176758;outline-offset:3px}.ds-control:active{filter:brightness(.92)}"
    },
    {
      "name": "Description field",
      "kind": "input",
      "refersTo": "input-description",
      "description": "Report field with semantic surface and emergency focus border. Illustrative light-theme HTML translation; Android remains authoritative.",
