      "css": ".ds-status{font-family:system-ui,sans-serif;font-size:14px;display:inline-block;font-size:12px;font-weight:600;background:#E6ECE3;color:#192D25;border:1px solid #D4DDD2;border-radius:6px;padding:3px 8px}"
    },
