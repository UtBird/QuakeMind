      "css": ".ds-card{font-family:system-ui,sans-serif;font-size:14px;background:#FEFFFC;color:#192D25;border:1px solid #D4DDD2;border-radius:16px;padding:20px}.ds-detail{color:#536159;font-size:14px;line-height:21px;margin-bottom:0}"
